#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLUSTER_NAME="${VOLGA_KIND_CLUSTER:-kubevolga}"
CONTEXT="kind-$CLUSTER_NAME"
ACTION="${1:-setup}"
REBUILD="${2:-}"

require() {
  command -v "$1" >/dev/null || {
    echo "missing required command: $1" >&2
    exit 2
  }
}

cluster_exists() {
  kind get clusters 2>/dev/null |
    awk -v name="$CLUSTER_NAME" '$0 == name { found = 1 } END { exit !found }'
}

kubectl_test() {
  kubectl --context "$CONTEXT" "$@"
}

# First extra node → infra (no worker taint). Remaining extras → volga-worker + NoSchedule.
# Control-plane is left unlabeled. Needs ≥1 extra node for infra; ≥2 for worker isolation.
apply_volga_node_roles() {
  local workers=()
  local node
  while IFS= read -r node; do
    if [[ -n "$node" ]]; then
      workers+=("$node")
    fi
  done < <(
    kubectl_test get nodes \
      -l '!node-role.kubernetes.io/control-plane' \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
  )

  if [[ ${#workers[@]} -eq 0 ]]; then
    echo "Kind cluster $CLUSTER_NAME has no extra worker nodes; skip volga.io/role labels" >&2
    echo "recreate with: scripts/kube-test-env destroy && scripts/kube-test-env setup" >&2
    return
  fi

  kubectl_test label --overwrite "node/${workers[0]}" volga.io/role=infra
  kubectl_test taint "node/${workers[0]}" volga.io/role=worker:NoSchedule- >/dev/null 2>&1 || true

  local i
  for ((i = 1; i < ${#workers[@]}; i++)); do
    kubectl_test label --overwrite "node/${workers[$i]}" volga.io/role=worker
    kubectl_test taint --overwrite "node/${workers[$i]}" volga.io/role=worker=worker:NoSchedule
  done

  if [[ ${#workers[@]} -lt 2 ]]; then
    echo "Kind cluster $CLUSTER_NAME has no volga-worker node; worker pods with nodeSelector will stay Pending" >&2
    echo "recreate with: scripts/kube-test-env destroy && scripts/kube-test-env setup" >&2
  fi
}

cleanup_resources() {
  if ! cluster_exists; then
    return
  fi

  while IFS= read -r resource; do
    if [[ -n "$resource" ]]; then
      kubectl_test -n default delete "$resource" --ignore-not-found=true
    fi
  done < <(
    kubectl_test -n default get volgapipeline -o name 2>/dev/null |
      awk -F/ '$2 ~ /^kube-harness-/'
  )

  kubectl_test delete -k "$ROOT/kubevolga/config/test-storage" \
    --ignore-not-found=true >/dev/null 2>&1 || true
}

setup() {
  require docker
  require kind
  require kubectl
  require make
  docker info >/dev/null

  if cluster_exists; then
    echo "using existing Kind cluster: $CLUSTER_NAME"
  else
    kind create cluster --name "$CLUSTER_NAME" --config "$ROOT/kubevolga/hack/kind-multi.yaml"
  fi
  kubectl_test wait --for=condition=Ready nodes --all --timeout=180s
  apply_volga_node_roles

  # Shared Buildx/GHA cache with the docker job (scope=volga-image).
  if [[ "$REBUILD" == "--rebuild" ]]; then
    "$ROOT/scripts/docker-test-env" build --rebuild
    "$ROOT/scripts/docker-test-env" build --rebuild \
      --tag kubevolga:dev \
      --context "$ROOT/kubevolga" \
      --scope kubevolga-image
  else
    "$ROOT/scripts/docker-test-env" build
    "$ROOT/scripts/docker-test-env" build \
      --tag kubevolga:dev \
      --context "$ROOT/kubevolga" \
      --scope kubevolga-image
  fi

  kind load docker-image kubevolga:dev --name "$CLUSTER_NAME"
  kind load docker-image volga:latest --name "$CLUSTER_NAME"

  make -C "$ROOT/kubevolga" \
    KUBECTL="kubectl --context $CONTEXT" install deploy
  kubectl_test wait --for=condition=Established \
    crd/volgapipelines.volga.io --timeout=120s
  cleanup_resources

  kubectl_test -n kubevolga-system rollout restart deployment/kubevolga-operator
  kubectl_test -n kubevolga-system rollout status \
    deployment/kubevolga-operator --timeout=120s
}

destroy() {
  require kind
  if cluster_exists; then
    kind delete cluster --name "$CLUSTER_NAME"
  else
    echo "Kind cluster does not exist: $CLUSTER_NAME"
  fi
}

case "$ACTION" in
  setup)
    setup
    ;;
  cleanup)
    require kind
    require kubectl
    cleanup_resources
    ;;
  destroy)
    destroy
    ;;
  *)
    echo "usage: scripts/kube-test-env {setup|cleanup|destroy} [--rebuild]" >&2
    exit 2
    ;;
esac
