#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ACTION="${1:-setup}"
if [[ $# -gt 0 ]]; then
  shift
fi

# Testcontainers images used by the docker test profile. Keep tags in sync with:
# - src/tests/docker/kafka.rs (redpanda)
# - src/tests/docker/parquet_s3.rs (localstack)
# - src/tests/docker/scylla.rs (scylla)
PREFETCH_IMAGES=(
  "localstack/localstack:3.0"
  "redpandadata/redpanda:latest"
  "scylladb/scylla:5.4"
)

OPTION=""
IMAGE_TAG="volga:latest"
IMAGE_CONTEXT="$ROOT"
CACHE_SCOPE="volga-image"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pull|--rebuild)
      OPTION="$1"
      shift
      ;;
    --tag)
      IMAGE_TAG="$2"
      shift 2
      ;;
    --context)
      IMAGE_CONTEXT="$2"
      shift 2
      ;;
    --scope)
      CACHE_SCOPE="$2"
      shift 2
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

prefetch_images() {
  local image
  for image in "${PREFETCH_IMAGES[@]}"; do
    echo "prefetching ${image}"
    docker pull "${image}"
  done
}

# Use Buildx + GitHub Actions cache when available (shared by docker/kube CI jobs).
# VOLGA_DOCKER_CACHE=gha|off|auto (default auto: gha on GitHub Actions).
use_gha_cache() {
  local mode="${VOLGA_DOCKER_CACHE:-auto}"
  case "$mode" in
    gha) return 0 ;;
    off) return 1 ;;
    auto)
      [[ "${GITHUB_ACTIONS:-}" == "true" ]] || return 1
      docker buildx version >/dev/null 2>&1 || return 1
      return 0
      ;;
    *)
      echo "unknown VOLGA_DOCKER_CACHE=${mode} (expected gha|off|auto)" >&2
      exit 2
      ;;
  esac
}

build_image() {
  local tag="$1"
  local context="$2"
  local scope="$3"
  local build_args=()

  case "$OPTION" in
    "")
      ;;
    --pull)
      build_args+=(--pull)
      ;;
    --rebuild)
      build_args+=(--no-cache)
      ;;
  esac

  if use_gha_cache; then
    echo "building ${tag} with buildx (cache scope=${scope})"
    docker buildx build \
      --load \
      --tag "$tag" \
      --cache-from "type=gha,scope=${scope}" \
      --cache-to "type=gha,mode=max,scope=${scope}" \
      "${build_args[@]}" \
      "$context"
  else
    echo "building ${tag} with docker build"
    docker build "${build_args[@]}" -t "$tag" "$context"
  fi
}

build() {
  command -v docker >/dev/null || {
    echo "missing required command: docker" >&2
    exit 2
  }
  docker info >/dev/null
  build_image "$IMAGE_TAG" "$IMAGE_CONTEXT" "$CACHE_SCOPE"
}

# One Scylla shard needs ~50k AIO slots. Docker Desktop and some CI kernels
# ship fs.aio-max-nr=65536, which is exhausted as soon as a second shard starts.
ensure_aio_slots() {
  local target=1048576
  local current=0
  if [[ -r /proc/sys/fs/aio-max-nr ]]; then
    current="$(cat /proc/sys/fs/aio-max-nr)"
  fi
  if [[ "${current}" -ge "${target}" ]]; then
    return 0
  fi
  if [[ -w /proc/sys/fs/aio-max-nr ]]; then
    echo "${target}" > /proc/sys/fs/aio-max-nr
    return 0
  fi
  if command -v sudo >/dev/null 2>&1 && sudo -n sysctl -w "fs.aio-max-nr=${target}" >/dev/null 2>&1; then
    return 0
  fi
  docker run --rm --privileged --entrypoint sh scylladb/scylla:5.4 -c "echo ${target} > /proc/sys/fs/aio-max-nr" >/dev/null 2>&1 || \
    echo "warning: could not raise fs.aio-max-nr; Scylla docker tests need it" >&2
}

setup() {
  command -v docker >/dev/null || {
    echo "missing required command: docker" >&2
    exit 2
  }
  docker info >/dev/null

  prefetch_images
  ensure_aio_slots
  build_image "$IMAGE_TAG" "$IMAGE_CONTEXT" "$CACHE_SCOPE"
}

case "$ACTION" in
  setup)
    setup
    ;;
  build)
    build
    ;;
  prefetch)
    command -v docker >/dev/null || {
      echo "missing required command: docker" >&2
      exit 2
    }
    docker info >/dev/null
    prefetch_images
    ;;
  *)
    echo "usage: scripts/docker-test-env {setup|build|prefetch} [--pull|--rebuild] [--tag TAG] [--context DIR] [--scope NAME]" >&2
    exit 2
    ;;
esac
