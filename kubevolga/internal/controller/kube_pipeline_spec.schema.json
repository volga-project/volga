{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KubePipelineSpec",
  "type": "object",
  "properties": {
    "event_time": {
      "$ref": "#/$defs/EventTimeSpec",
      "default": {
        "watermark": {
          "idle_timeout_ms": null,
          "out_of_orderness_ms": 0
        },
        "window": {
          "allowed_lateness_ms": 0
        }
      }
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode",
      "default": "Streaming"
    },
    "execution_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operator_overrides": {
      "default": {
        "defaults": {
          "transport": null,
          "tuning": null
        },
        "per_operator": {}
      }
    },
    "parallelism": {
      "type": "integer",
      "format": "uint",
      "default": 1,
      "minimum": 0
    },
    "request_source_sink": {
      "default": null
    },
    "sink": {
      "default": null
    },
    "sources": {
      "default": []
    },
    "sql": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "state": {
      "$ref": "#/$defs/StateSpec",
      "default": {
        "checkpoint": {
          "interval_ms": 0,
          "retention": 1,
          "timeout_ms": 60000
        },
        "checkpoint_store": "in_memory",
        "maintenance_enabled": true,
        "maintenance_interval_ms": 1000,
        "operator_backend": "in_memory",
        "request_store": null
      }
    },
    "task_assignment_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskWorkerAssignmentStrategyType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "worker_runtime": {
      "default": {
        "history_retention_window_ms": null,
        "transport": {
          "default_queue_records": 8192
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CheckpointSpec": {
      "description": "Job checkpoint knobs. Spec is the only source.\n`interval_ms: 0` disables interval checkpoints. Missing fields are off / no timeout\nat runtime (no panic); [`crate::api::PipelineSpec::validate`] requires all three.",
      "type": "object",
      "properties": {
        "interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retention": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "CheckpointStoreConfig": {
      "type": "string",
      "enum": [
        "in_memory"
      ]
    },
    "EventTimeSpec": {
      "description": "Pipeline-wide event-time defaults (SQL / streaming).\n\nWatermark knobs are shared; window `allowed_lateness_ms` is retention-only\n(prune after advance). Streaming late ingest is `ts ≤ task watermark`.",
      "type": "object",
      "properties": {
        "watermark": {
          "$ref": "#/$defs/WatermarkSpec",
          "default": {
            "idle_timeout_ms": null,
            "out_of_orderness_ms": 0
          }
        },
        "window": {
          "$ref": "#/$defs/WindowEventTimeSpec",
          "default": {
            "allowed_lateness_ms": 0
          }
        }
      }
    },
    "ExecutionMode": {
      "type": "string",
      "enum": [
        "Request",
        "Streaming",
        "Batch"
      ]
    },
    "ExecutionProfile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "SingleWorker": {
              "type": "object",
              "properties": {
                "num_threads_per_task": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "num_threads_per_task"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SingleWorker"
          ]
        },
        {
          "type": "object",
          "properties": {
            "MasterWorker": {
              "type": "object",
              "properties": {
                "num_threads_per_task": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "num_threads_per_task"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "MasterWorker"
          ]
        }
      ]
    },
    "OperatorStateBackendConfig": {
      "type": "string",
      "enum": [
        "in_memory"
      ]
    },
    "RequestStoreConfig": false,
    "StateSpec": {
      "type": "object",
      "properties": {
        "checkpoint": {
          "description": "Per-job checkpoint interval / timeout / retention. Spec is the only source.\n`interval_ms: 0` disables interval checkpoints.",
          "$ref": "#/$defs/CheckpointSpec",
          "default": {
            "interval_ms": 0,
            "retention": 1,
            "timeout_ms": 60000
          }
        },
        "checkpoint_store": {
          "$ref": "#/$defs/CheckpointStoreConfig",
          "default": "in_memory"
        },
        "maintenance_enabled": {
          "description": "When true, workers run periodic `OperatorStore::maintain`.",
          "type": "boolean",
          "default": true
        },
        "maintenance_interval_ms": {
          "description": "Cleaner tick interval in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "default": 1000,
          "minimum": 0
        },
        "operator_backend": {
          "$ref": "#/$defs/OperatorStateBackendConfig",
          "default": "in_memory"
        },
        "request_store": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestStoreConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "TaskWorkerAssignmentStrategyType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "SingleWorker",
            "OperatorPerWorker"
          ]
        },
        {
          "description": "Flink-like slot scheduling: each task-index slice across all operators\nis placed into one slot on one worker; `slots_per_node` controls slices per worker.",
          "type": "object",
          "properties": {
            "Pipelined": {
              "type": "object",
              "properties": {
                "slots_per_node": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "slots_per_node"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Pipelined"
          ]
        }
      ]
    },
    "WatermarkSpec": {
      "type": "object",
      "properties": {
        "emit_interval_ms": {
          "description": "Processing-time interval for coalescing watermark emits (ms).\nUnset uses the runtime default (200ms). Batch does not assign watermarks (EOF flush only).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "idle_timeout_ms": {
          "description": "If set, idle upstreams older than this are excluded from min-WM merge.\n`None` keeps the runtime assigner default (`WatermarkAssignConfig::DEFAULT_IDLE_TIMEOUT_MS`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "out_of_orderness_ms": {
          "description": "Max event-time reorder delay for auto-placed watermark assigners (ms).",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      }
    },
    "WindowEventTimeSpec": {
      "type": "object",
      "properties": {
        "allowed_lateness_ms": {
          "description": "Window state retention after advance (ms). Default `0`: prune below\n`watermark − max_window_length`. Does not delay watermarks or accept\npost-frontier ingest; CDC late-data is separate.",
          "type": "integer",
          "format": "int64",
          "default": 0
        }
      }
    }
  }
}